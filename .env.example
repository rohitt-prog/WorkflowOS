# ==============================================================================
# WorkFlowOS — Environment Configuration Template
# Copy this file to .env and configure the values for your local environment:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control or expose real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas Configuration
# ------------------------------------------------------------------------------
# Required for persistent workflows, event logging, and execution history.
# For local testing without Atlas, test runners use an in-memory fallback.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=workflowos

# ------------------------------------------------------------------------------
# 2. Backend Server Configuration
# ------------------------------------------------------------------------------
# HOST: Local bind address. Defaults to 127.0.0.1 (loopback) for local security.
# PORT: Local backend API server port (default: 8000).
# FRONTEND_ORIGIN: Trusted frontend URL for CORS and CSRF validation.
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Frontend Client Configuration (used by Next.js)
# ------------------------------------------------------------------------------
# URL of the WorkFlowOS backend API accessed by the browser / Next.js frontend.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 4. AI / Google Gemini API Configuration (Phase 3)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for AI workflow generation and natural language prompt translation.
# Get an API key from Google AI Studio: https://aistudio.google.com/
# GEMINI_MODEL: Model identifier (default: gemini-2.5-flash).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. Automation / Playwright Configuration (Phase 4.3)
# ------------------------------------------------------------------------------
# Base URL and headless mode for browser-based automation tasks.
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_HEADLESS=true

# ------------------------------------------------------------------------------
# 6. Google OAuth 2.0 & Gmail Integration (Phase 7.2)
# ------------------------------------------------------------------------------
# Required only if using the Gmail integration.
# Obtain from Google Cloud Console -> APIs & Services -> Credentials:
# - Create an OAuth 2.0 Client ID (Web Application).
# - Add Authorized Redirect URI matching GOOGLE_REDIRECT_URI exactly.
# Note: Google OAuth considers 127.0.0.1 and localhost distinct origins.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/gmail/callback

# ------------------------------------------------------------------------------
# 7. Credential Encryption Key (Phase 7.1 / 7.2)
# ------------------------------------------------------------------------------
# Required for encrypting OAuth tokens in-memory via Fernet (AES-128-CBC + HMAC-SHA256).
# Must be a 32-byte URL-safe base64-encoded key.
# Generate locally using:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WORKFLOWOS_CREDENTIAL_KEY=
